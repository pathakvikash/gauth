# Local dev default: SQLite file. In production (Vercel) DATABASE_URL is set to a
# Postgres connection string instead — see config/db.config.mjs and README.md.
DATABASE_URL="file:./dev.db"

# Google OAuth (console.cloud.google.com -> APIs & Services -> Credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google (dev)
#                          https://<your-domain>/api/auth/callback/google (prod)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# NextAuth (Auth.js) — generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Signs the short-lived vault-unlock cookie. Must be a DIFFERENT secret from AUTH_SECRET
# so compromising one never compromises the other. Generate with: openssl rand -base64 32
VAULT_COOKIE_SECRET=""

# Resend (resend.com) — used only to send the "vault locked" security alert email.
# If left unset, the alert is logged to the console instead of sent (fine for local dev).
RESEND_API_KEY=""
EMAIL_FROM="Gauth Security <security@yourdomain.com>"

# Explicit dev/prod override for config/db.config.mjs. Leave unset locally — it infers
# "dev". Vercel sets VERCEL_ENV=production automatically, which resolves to "prod".
# APP_ENV="dev"
